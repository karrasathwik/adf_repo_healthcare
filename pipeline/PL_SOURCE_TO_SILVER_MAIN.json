{
	"name": "PL_SOURCE_TO_SILVER_MAIN",
	"properties": {
		"activities": [
			{
				"name": "Readsourcelist",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id from ctrl.table_config where is_active = 1 and source_system = '@{pipeline().parameters.source_system}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ingestallltables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Readsourcelist",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Readsourcelist').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "ingest_from_source_to_sliver",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "insert_progress_status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SOURCE_TO_SLVER_INNER",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "insert_progress_status",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LSAZURESQLDATABASE",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "\nINSERT INTO ctrl.audit_log\n    (adf_run_id, table_id, stage, status, start_time)\nVALUES\n    ('a1', @{item().table_id}, 'IN_PROGRESS', SYSUTCDATETIME());",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "update_failed_status",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "ingest_from_source_to_sliver",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LSAZURESQLDATABASE",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.audit_log set STATUS = 'FAILED', end_time = SYSUTCDATETIME()\nWHERE adf_run_id='@{pipeline().parameters.asf_run_id}' and table_id = @{item().table_id}\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"source_system": {
				"type": "string",
				"defaultValue": "neon_postgres"
			},
			"asf_run_id": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			},
			"test1": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}